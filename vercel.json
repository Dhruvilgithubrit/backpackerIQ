{
  "version": 2,
  "buildCommand": "cd backpackeriq-app && npm install && npm run build",
  "outputDirectory": "backpackeriq-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backpackeriq-server.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
